# Supply-chain protections (requires npm >= 11.10)

# Cooldown: only resolve versions that have been published for at least 7 days,
# so freshly compromised releases are usually caught and unpublished first.
min-release-age=7

# Don't run dependency lifecycle scripts (preinstall/install/postinstall).
# None of our dependencies need them for the site to build.
ignore-scripts=true

# Refuse dependencies fetched from git URLs, which bypass the registry.
allow-git=none

# Refuse packages that declare an incompatible Node.js version.
engine-strict=true
