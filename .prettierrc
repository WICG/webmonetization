{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": "**/*.astro",
      "options": {
        "parser": "astro"
      }
    },
    {
      "files": "**/*.mdx",
      "options": {
        "proseWrap": "preserve"
      }
    },
    {
      "files": "specification/explainer.md",
      "options": {
        "proseWrap": "always",
        "printWidth": 80
      }
    }
  ]
}
